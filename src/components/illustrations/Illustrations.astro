<!-- Register each illustration once; Markdown places independent instances. -->
<script>
  import "./StackPushPop"
  import "./CBuffer"
  import "./BufferOverflow"
  import "./ProcessMemoryMap"
  import "./FunctionCalls"
  import "./WorkshopSlides"
  import "./ReverseEngineeringProcess"
  import "./OverflowWalkthrough"
  import "./SecretOverwrite"
  import "./IntegerVulnerability"
  import "./LocalVariableSolve"
  import "./GlobalVariableSolve"
  import "./Ret2WinSolve"
  import "./CanarySolve"

  const selector = "details[data-illustration]"
  const panels = [...document.querySelectorAll<HTMLDetailsElement>(selector)]
  const componentOf = (panel: HTMLDetailsElement) =>
    [...panel.children].find(
      (child): child is HTMLElement =>
        child instanceof HTMLElement && !!customElements.get(child.localName),
    )

  const readLink = (url: URL) => {
    const fragment = url.hash.slice(1)
    const separator = fragment.indexOf("?")
    const hashParams = new URLSearchParams(
      separator < 0 ? "" : fragment.slice(separator + 1),
    )
    let id = separator < 0 ? fragment : fragment.slice(0, separator)
    try {
      id = decodeURIComponent(id)
    } catch {
      id = ""
    }
    const aliases: Record<string, { id: string; kind?: string }> = {
      "buffers-integers": { id: "buffers", kind: "int" },
      "buffers-strings": { id: "buffers", kind: "string" },
      "push-pop": { id: "push--pop" },
    }
    const alias = aliases[id]
    return {
      id: alias?.id ?? id,
      kind: alias?.kind,
      full: (hashParams.get("full") ?? url.searchParams.get("full")) === "true",
    }
  }

  type Presentation = {
    panel: HTMLDetailsElement
    component: HTMLElement
    background: HTMLElement[]
    title: string
    observer: MutationObserver
  }
  let presentation: Presentation | undefined

  const openPanel = (panel: HTMLDetailsElement) => {
    const article = panel.closest("article")
    for (const other of panels) {
      if (other !== panel && other.closest("article") === article) {
        other.open = false
      }
    }
    panel.open = true
  }

  for (const article of document.querySelectorAll("article")) {
    const illustrations = [
      ...article.querySelectorAll<HTMLDetailsElement>(selector),
    ]
    if (!illustrations.length) continue

    const nav = document.createElement("nav")
    nav.className = "illustration-index"
    const contentsLabel = illustrations.some((panel) =>
      panel.hasAttribute("data-slide"),
    )
      ? "Workshop contents"
      : "Illustrations"
    nav.setAttribute("aria-label", contentsLabel)
    const title = document.createElement("p")
    title.textContent = contentsLabel
    const list = document.createElement("ol")

    for (const panel of illustrations) {
      panel.open = false
      const heading = panel.querySelector<HTMLElement>(
        ":scope > summary :is(h2, h3)[id]",
      )
      if (!heading) continue
      const item = document.createElement("li")
      const link = document.createElement("a")
      link.href = `#${encodeURIComponent(heading.id)}`
      link.textContent = heading.textContent?.trim() ?? ""
      item.append(link)
      list.append(item)

      if (componentOf(panel)) {
        const fullLink = document.createElement("a")
        const url = new URL(location.href)
        url.searchParams.set("full", "true")
        url.hash = heading.id
        fullLink.href = url.href
        fullLink.className = "illustration-full-link"
        fullLink.textContent = "Fullscreen"
        fullLink.setAttribute(
          "aria-label",
          `Open ${link.textContent} fullscreen`,
        )
        panel.querySelector(":scope > summary")!.append(fullLink)
      }
    }

    if (list.children.length && !article.querySelector("workshop-slides")) {
      nav.append(title, list)
      illustrations[0].before(nav)
    }
  }

  for (const panel of panels) {
    panel.addEventListener("toggle", () => {
      if (panel.open) openPanel(panel)
    })
  }

  const panelForHash = (hash: string) => {
    if (!hash) return null
    const url = new URL(location.href)
    url.hash = hash
    return document
      .getElementById(readLink(url).id)
      ?.closest<HTMLDetailsElement>(selector)
  }

  const exitPresentation = (updateURL = true) => {
    if (!presentation) return
    const { panel, component, background, title, observer } = presentation
    presentation = undefined
    observer.disconnect()
    component.removeAttribute("data-expanded")
    panel.removeAttribute("data-presentation")
    panel.removeAttribute("role")
    panel.removeAttribute("aria-modal")
    panel.removeAttribute("aria-label")
    for (const element of background) element.inert = false
    document.documentElement.removeAttribute("data-illustration-full")
    document.title = title
    if (updateURL) {
      const url = new URL(location.href)
      url.searchParams.delete("full")
      const heading = panel.querySelector<HTMLElement>(
        ":scope > summary :is(h2, h3)[id]",
      )
      url.hash = heading?.id ?? ""
      history.replaceState(history.state, "", url)
      requestAnimationFrame(() => {
        panel
          .querySelector<HTMLElement>(":scope > summary")
          ?.focus({ preventScroll: true })
        panel.scrollIntoView({ block: "start" })
      })
    }
  }

  const showPresentation = (panel: HTMLDetailsElement, kind?: string) => {
    const component = componentOf(panel)
    if (!component) return false
    if (kind) {
      const select = component.shadowRoot?.querySelector<HTMLSelectElement>(
        "[data-setting=kind]",
      )
      if (select && select.value !== kind) {
        select.value = kind
        select.dispatchEvent(new Event("change", { bubbles: true }))
      }
    }
    if (presentation?.panel === panel) return true
    exitPresentation(false)
    openPanel(panel)
    const background: HTMLElement[] = []
    let branch: HTMLElement = panel
    while (branch.parentElement && branch !== document.body) {
      for (const sibling of branch.parentElement.children) {
        if (
          sibling !== branch &&
          sibling instanceof HTMLElement &&
          !sibling.inert
        ) {
          sibling.inert = true
          background.push(sibling)
        }
      }
      branch = branch.parentElement
    }
    const observer = new MutationObserver(() => {
      if (!component.hasAttribute("data-expanded")) exitPresentation()
    })
    presentation = {
      panel,
      component,
      background,
      title: document.title,
      observer,
    }
    const title =
      panel.querySelector("summary :is(h2, h3)")?.textContent?.trim() ??
      "Illustration"
    panel.setAttribute("data-presentation", "")
    panel.setAttribute("role", "dialog")
    panel.setAttribute("aria-modal", "true")
    panel.setAttribute("aria-label", title)
    document.documentElement.setAttribute("data-illustration-full", "")
    document.title = title
    component.setAttribute("data-expanded", "")
    observer.observe(component, {
      attributes: true,
      attributeFilter: ["data-expanded"],
    })
    requestAnimationFrame(() => {
      if (presentation?.component === component) {
        component.shadowRoot
          ?.querySelector<HTMLElement>("button:not(:disabled), select, input")
          ?.focus({ preventScroll: true })
      }
    })
    return true
  }

  const reveal = (panel: HTMLDetailsElement, focus = false) => {
    openPanel(panel)
    if (focus) {
      panel
        .querySelector<HTMLElement>(":scope > summary")
        ?.focus({ preventScroll: true })
    }
    // Wait until the previous panel closes before calculating the destination.
    requestAnimationFrame(() => panel.scrollIntoView({ block: "start" }))
  }

  document.addEventListener(
    "click",
    (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return
      const link = (event.target as Element).closest<HTMLAnchorElement>(
        "a[href]",
      )
      if (!link || link.target || link.hasAttribute("download")) return
      if (
        link.origin !== location.origin ||
        link.pathname !== location.pathname
      )
        return
      const panel = panelForHash(link.hash)
      if (!panel) return

      const target = readLink(new URL(link.href))
      if (target.full && componentOf(panel)) {
        event.preventDefault()
        history.pushState(history.state, "", link.href)
        showPresentation(panel, target.kind)
        return
      }
      if (link.search !== location.search) return

      event.preventDefault()
      if (location.hash !== link.hash)
        history.pushState(history.state, "", link.hash)
      reveal(panel, true)
    },
    { capture: true },
  )

  const syncLocation = (initial = false) => {
    const target = readLink(new URL(location.href))
    const panel = panelForHash(location.hash)
    if (target.full && panel && showPresentation(panel, target.kind)) return
    exitPresentation(false)
    if (initial) {
      for (const panel of panels) panel.open = false
    } else if (panel) reveal(panel)
  }
  addEventListener("hashchange", () => syncLocation())
  addEventListener("popstate", () => syncLocation())
  addEventListener("pageshow", () => syncLocation(true))
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && presentation) {
      event.preventDefault()
      exitPresentation()
    }
  })
  syncLocation(true)
</script>

<style is:global>
  prose-content .illustration-index {
    margin-block: 1.5rem;
    padding-block-end: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  prose-content .illustration-index > p {
    margin-block-end: 0.5rem;
    color: var(--foreground);
    font-weight: var(--font-weight-medium);
  }

  prose-content .illustration-index ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 0.375rem 1.5rem;
    margin: 0;
    padding-inline-start: 1.5rem;
    list-style: decimal;
  }

  prose-content .illustration-index li {
    margin: 0;
    padding: 0;
  }

  prose-content details[data-illustration] {
    margin-block: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    scroll-margin-block-start: 1rem;
  }

  prose-content details[data-illustration] > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    margin: 0;
    cursor: pointer;
    list-style: none;
  }

  prose-content details[data-illustration] > summary::-webkit-details-marker {
    display: none;
  }

  prose-content details[data-illustration] > summary::after {
    content: "";
    flex-shrink: 0;
    width: 0.45rem;
    height: 0.45rem;
    margin-inline-end: 0.15rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    color: var(--muted-foreground);
  }

  prose-content details[data-illustration][open] > summary::after {
    transform: rotate(225deg);
  }

  prose-content details[data-illustration][open] > summary {
    border-bottom: 1px solid var(--border);
  }

  prose-content details[data-illustration] > summary > :is(h2, h3) {
    flex: 1;
    margin: 0;
    font-size: var(--step-0);
  }

  prose-content .illustration-full-link {
    flex-shrink: 0;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: var(--font-weight-normal);
  }

  html[data-illustration-full] {
    scrollbar-gutter: auto;
    scroll-padding: 0;
  }

  html[data-illustration-full] body {
    overflow: hidden;
  }

  html[data-illustration-full]
    :is(page-header, page-footer, [data-scroll-top]) {
    visibility: hidden;
  }

  prose-content details[data-illustration][data-presentation] {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: var(--background);
  }

  prose-content details[data-presentation] > summary {
    display: none;
  }

  prose-content
    details[data-illustration]
    > :is(
      stack-push-pop,
      c-buffer,
      buffer-overflow,
      process-memory-map,
      function-calls
    ) {
    margin: 0;
  }

  prose-content details[data-illustration] > .illustration-body {
    padding: 1.25rem;
  }

  prose-content .illustration-body > :first-child {
    margin-block-start: 0;
  }

  prose-content .illustration-body > :last-child {
    margin-block-end: 0;
  }
</style>
